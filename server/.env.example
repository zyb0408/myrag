# ===== RAGFlow 服务配置 =====
# RAGFlow 服务地址（含端口）
RAGFLOW_BASE_URL=http://localhost:9380
# RAGFlow API Key（在 RAGFlow 平台「API Key」处生成）
RAGFLOW_API_KEY=ragflow-your-api-key-here
# RAGFlow API 版本：v0.24+ 使用 extra_body 格式，legacy 使用顶层 reference 参数
RAGFLOW_API_VERSION=legacy

# ===== BFF 服务配置 =====
# BFF 服务监听端口（前端 Vite 代理指向该端口）
BFF_PORT=3001

# ===== 安全配置 =====
# JWT 签名密钥（生产环境务必修改为随机强密钥）
JWT_SECRET=ragflow-knowledge-qa-secret-change-in-production